# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS) - you can separate multiple origins with a comma
FRONTEND_URL=http://localhost:4300, https://nova.goreng.my.id

# JWT Secrets 
# REQUIRED: Generate strong random strings! (e.g. openssl rand -base64 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Database
DATABASE_PATH=./data/nova_central.db

# Google Drive
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# Backup defaults
DEFAULT_SOURCE_PATH=/home/user/backup-source
BACKUP_SCHEDULE=0 */6 * * *

# Admin seed (first run only)
ADMIN_USERNAME=admin
# REQUIRED: You must set an initial admin password!
ADMIN_PASSWORD=
